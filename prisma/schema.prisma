// Prisma schema for Lokaa Exports Enterprise ERP Portal
// Complete RBAC + CRM + Product Management + RFQ + Order Management

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// AUTHENTICATION & AUTHORIZATION
// ============================================

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  slug        String           @unique
  description String?          @db.Text
  level       Int              @default(0) // 0=SuperAdmin, 1=Admin, 2=Employee
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([slug])
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  slug        String           @unique
  description String?          @db.Text
  module      String // 'rbac', 'crm', 'products', 'rfqs', 'orders', 'employees', 'analytics', etc
  action      String // 'create', 'read', 'update', 'delete', 'manage'
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@index([module])
  @@index([action])
}

// Junction table for Role-Permission many-to-many
model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ============================================
// USERS & EMPLOYEES
// ============================================

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  username  String? @unique
  password  String // bcrypt hash
  emailVerified Boolean @default(true)
  firstName String
  lastName  String
  phone     String?
  avatar    String?
  roleId    Int
  role      Role    @relation(fields: [roleId], references: [id])

  // Employee specific fields
  employeeId          String?   @unique
  department          String?
  designation         String?
  reportingManagerId  String? // Self-referencing for manager hierarchy
  joiningDate         DateTime?
  status              String    @default("active") // active, inactive, suspended, terminated
  isTemporaryPassword Boolean   @default(true)
  lastPasswordChange  DateTime?

  // Assignments
  assignedCustomers CustomerAssignment[]
  assignedProducts  ProductAssignment[]
  assignedCountries CountryAssignment[]
  assignedRFQs      RFQAssignment[]
  assignedTasks     TaskAssignment[]
  assignedLeads     LeadAssignment[]

  // Activity tracking
  loginHistory    LoginHistory[]
  authTokens      AuthToken[]
  lastLogin       DateTime?
  lastLoginIp     String?
  lastLoginDevice String?

  // Created/Updated by tracking
  createdRFQs       RFQ[]          @relation("CreatedBy")
  updatedRFQs       RFQ[]          @relation("UpdatedBy")
  createdOrders     Order[]        @relation("CreatedBy")
  createdTasks      Task[]         @relation("CreatedBy")
  completedTasks    Task[]         @relation("CompletedBy")
  createdActivities Activity[]     @relation("CreatedBy")
  notifications     Notification[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([roleId])
  @@index([status])
}

model AuthToken {
  id        String   @id @default(cuid())
  userId    String?
  customerId String?
  email     String
  tokenHash String
  type      String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  usedAt    DateTime?

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([email, type])
  @@index([tokenHash])
  @@index([expiresAt])
}

model AuthThrottle {
  id        String   @id @default(cuid())
  scope     String
  identifier String
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, identifier])
  @@index([scope, resetAt])
}

model LoginHistory {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  device    String?
  userAgent String?  @db.Text
  status    String // 'success', 'failed'
  reason    String? // For failed logins
  loginAt   DateTime @default(now())

  @@index([userId])
  @@index([loginAt])
}

// ============================================
// COMPANY & CONFIGURATION
// ============================================

model Company {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  logo        String?
  favicon     String?
  description String? @db.Text
  industry    String?
  website     String?
  email       String?
  phone       String?
  address     String? @db.Text
  city        String?
  state       String?
  postalCode  String?
  country     String?

  timezone   String @default("UTC")
  currency   String @default("USD")
  language   String @default("en")
  dateFormat String @default("YYYY-MM-DD")

  enableTwoFactor   Boolean @default(false)
  enableAuditLog    Boolean @default(true)
  enableActivityLog Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// CRM - CUSTOMERS
// ============================================

model Customer {
  id                 String  @id @default(cuid())
  customerNumber     String? @unique
  companyName        String
  slug               String  @unique
  registrationNumber String?
  industry           String?
  businessType       String?
  website            String?
  email              String
  phone              String?
  alternatePhone     String?

  contactName        String?
  contactDesignation String?
  contactEmail       String?
  contactPhone       String?
  country            String?
  address            String?
  gstNumber          String?
  profilePicture     String?
  lastLogin          DateTime?

  passwordHash       String?
  emailVerified      Boolean @default(false)
  otpCodeHash        String?
  otpExpiresAt       DateTime?
  otpAttempts        Int     @default(0)
  loginAttempts      Int     @default(0)
  lastLoginAttempt   DateTime?
  lastPasswordChange DateTime?

  addresses CustomerAddress[]

  leads       Lead[]
  rfqs        RFQ[]
  orders      Order[]
  assignments CustomerAssignment[]
  notes       Note[]
  authTokens  AuthToken[]

  status     String  @default("active")
  rating     Int?
  totalSpent Decimal @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([status])
  @@index([businessType])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type       String
  address    String
  city       String
  state      String
  postalCode String
  country    String

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model CustomerAssignment {
  id         String   @id @default(cuid())
  customerId String
  userId     String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())
  assignedBy String?

  @@unique([customerId, userId])
  @@index([customerId])
  @@index([userId])
}

// ============================================
// CRM - LEADS
// ============================================

model Lead {
  id         String   @id @default(cuid())
  reference  String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  title       String
  description String? @db.Text
  source      String?

  status String  @default("new")
  stage  String?

  assignment LeadAssignment?

  interestedProducts String? @db.Text

  notes      Note[]
  activities Activity[]

  expectedValue  Decimal?
  closingDate    DateTime?
  winProbability Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([reference])
}

model LeadAssignment {
  id     String @id @default(cuid())
  leadId String @unique
  userId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())
  assignedBy String?

  @@index([leadId])
  @@index([userId])
}

// ============================================
// ACTIVITY TRACKING (Audit Trail)
// ============================================

model Activity {
  id     String  @id @default(cuid())
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type        String
  title       String
  description String? @db.Text

  oldValue String? @db.Text
  newValue String? @db.Text

  createdBy     String?
  createdByUser User?   @relation("CreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([type])
  @@index([createdAt])
}

model Note {
  id      String @id @default(cuid())
  content String @db.Text

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([leadId])
}

// ============================================
// PRODUCTS & CATALOG
// ============================================

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String? @db.Text
  image       String?
  bannerImage String?
  icon        String?
  sortOrder   Int     @default(0)

  parentId Int?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  seoTitle       String?
  seoDescription String? @db.Text
  keywords       String?

  status String @default("published")

  products      Product[]
  subcategories SubCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([slug])
}

model SubCategory {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String? @db.Text
  bannerImage String?
  icon        String?
  sortOrder   Int     @default(0)

  categoryId Int
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  parentId   Int?
  parent     SubCategory?  @relation("SubCategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   SubCategory[] @relation("SubCategoryHierarchy")

  seoTitle       String?
  seoDescription String? @db.Text

  status String @default("published")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
}

model Product {
  id               String  @id @default(cuid())
  sku              String  @unique
  hsCode           String?
  name             String
  slug             String  @unique
  description      String? @db.Text
  shortDescription String? @db.Text

  categoryId    Int
  category      Category     @relation(fields: [categoryId], references: [id])
  subCategoryId Int?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])

  specifications Json?
  applications   String? @db.Text
  packaging      Json?

  price    Decimal @default(0)
  currency String  @default("USD")
  moq      Int     @default(1)
  leadTime String?

  certifications String? @db.Text

  countries   CountryProduct[]
  assignments ProductAssignment[]

  stock             Int @default(0)
  lowStockThreshold Int @default(10)

  seoTitle       String?
  seoDescription String? @db.Text
  seoKeywords    String?
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  altText        String?

  status String @default("draft")

  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([status])
  @@index([sku])
}

model ProductAssignment {
  id        String  @id @default(cuid())
  productId String
  userId    String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}

// ============================================
// COUNTRIES & REGIONAL MANAGEMENT
// ============================================

model Country {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String  @unique
  region String?

  products    CountryProduct[]
  assignments CountryAssignment[]

  createdAt DateTime @default(now())

  @@index([code])
  @@index([region])
}

model CountryProduct {
  id        String  @id @default(cuid())
  countryId String
  productId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  isAvailable Boolean  @default(true)
  addedAt     DateTime @default(now())

  @@unique([countryId, productId])
  @@index([countryId])
  @@index([productId])
}

model CountryAssignment {
  id        String  @id @default(cuid())
  countryId String
  userId    String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([countryId, userId])
  @@index([countryId])
  @@index([userId])
}

// ============================================
// RFQ MANAGEMENT
// ============================================

model RFQ {
  id         String   @id @default(cuid())
  reference  String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  submittedDate DateTime

  items RFQItem[]

  productInterest String?   @db.Text
  quantity        Int?
  unit            String?
  shipmentDate    DateTime?

  assignedSalesPerson String?

  status   String @default("new")
  priority String @default("normal")

  internalNotes String? @db.Text

  quotations RFQQuotation[]

  orders Order[]

  createdBy     String
  createdByUser User    @relation("CreatedBy", fields: [createdBy], references: [id])
  updatedBy     String?
  updatedByUser User?   @relation("UpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  assignment RFQAssignment?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  @@index([customerId])
  @@index([status])
  @@index([reference])
  @@index([createdAt])
}

model RFQItem {
  id    String @id @default(cuid())
  rfqId String
  rfq   RFQ    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  productId   String?
  description String?
  quantity    Int
  unit        String

  createdAt DateTime @default(now())

  @@index([rfqId])
}

model RFQQuotation {
  id    String @id @default(cuid())
  rfqId String
  rfq   RFQ    @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  version Int @default(1)

  items    Json
  subtotal Decimal
  tax      Decimal @default(0)
  total    Decimal
  currency String  @default("USD")

  validUntil DateTime

  notes String? @db.Text

  status String @default("draft")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rfqId])
  @@index([status])
}

model RFQAssignment {
  id     String @id @default(cuid())
  rfqId  String @unique
  userId String
  rfq    RFQ    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@index([rfqId])
  @@index([userId])
}

// ============================================
// ORDER MANAGEMENT
// ============================================

model Order {
  id         String   @id @default(cuid())
  reference  String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  rfqId String?
  rfq   RFQ?    @relation(fields: [rfqId], references: [id], onDelete: SetNull)

  items OrderItem[]

  subtotal Decimal @default(0)
  tax      Decimal @default(0)
  discount Decimal @default(0)
  shipping Decimal @default(0)
  total    Decimal @default(0)
  currency String  @default("USD")

  shipmentAddress   String?   @db.Text
  shippingMethod    String?
  estimatedDelivery DateTime?

  status        String @default("pending")
  paymentStatus String @default("unpaid")

  createdBy     String
  createdByUser User   @relation("CreatedBy", fields: [createdBy], references: [id])

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([reference])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  quantity  Int
  unitPrice Decimal
  total     Decimal

  createdAt DateTime @default(now())

  @@index([orderId])
}

// ============================================
// TASK MANAGEMENT
// ============================================

model Task {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text

  type String?

  dueDate DateTime

  assignments TaskAssignment[]

  status   String @default("pending")
  priority String @default("normal")

  createdBy       String
  createdByUser   User      @relation("CreatedBy", fields: [createdBy], references: [id])
  completedBy     String?
  completedByUser User?     @relation("CompletedBy", fields: [completedBy], references: [id], onDelete: SetNull)
  completedAt     DateTime?

  createdAt DateTime @default(now())
}

// ============================================
// DYNAMIC PRODUCT MANAGEMENT SYSTEM
// ============================================

// Product Categories
model ProductCategory {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  description  String? @db.Text
  image        String?
  displayOrder Int     @default(0)
  status       String  @default("active")

  subcategories ProductSubcategory[]
  templates     ProductTemplate[]
  products      DynamicProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
}

// Product Subcategories
model ProductSubcategory {
  id         String          @id @default(cuid())
  categoryId String
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name         String
  slug         String
  description  String? @db.Text
  displayOrder Int     @default(0)
  status       String  @default("active")

  templates ProductTemplate[]
  products  DynamicProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([slug])
}

// Product Templates (Dynamic Form Templates)
model ProductTemplate {
  id            String              @id @default(cuid())
  categoryId    String
  category      ProductCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId String?
  subcategory   ProductSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  name         String
  slug         String
  description  String? @db.Text
  fieldCount   Int     @default(0)
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  fields   ProductTemplateField[]
  products DynamicProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isActive])
}

// Template Fields (Dynamic Fields)
model ProductTemplateField {
  id         String          @id @default(cuid())
  templateId String
  template   ProductTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  fieldName       String
  fieldLabel      String
  fieldType       String // TEXT, NUMBER, DROPDOWN, MULTI_SELECT, IMAGE, RICH_TEXT, DATE, BOOLEAN, TEXTAREA
  isRequired      Boolean @default(false)
  displayOrder    Int
  placeholder     String?
  helpText        String? @db.Text
  validationRules Json? // JSON with min, max, pattern, etc.
  defaultValue    String?
  options         Json? // For dropdown/multi-select

  specifications ProductSpecification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@index([displayOrder])
}

// Master Product Table
model DynamicProduct {
  id            String              @id @default(cuid())
  productName   String
  slug          String              @unique
  categoryId    String
  category      ProductCategory     @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   ProductSubcategory? @relation(fields: [subcategoryId], references: [id])
  templateId    String
  template      ProductTemplate     @relation(fields: [templateId], references: [id])

  shortDescription  String? @db.Text
  description       String? @db.Text
  exportDescription String? @db.Text

  hsnCode     String?
  productType String?

  status             String  @default("draft") // draft, published, archived
  isFeatured         Boolean @default(false)
  availabilityStatus String  @default("in_stock") // in_stock, out_of_stock, discontinued

  mainImage String? // URL to main image

  specifications      ProductSpecification[]
  images              ProductImage[]
  packaging           ProductPackaging[]
  certifications      ProductCertification[]
  seo                 ProductSEO?
  exportInfo          ProductExportInfo?
  documents           ProductDocument[]
  videos              ProductVideo[]
  variants            ProductVariant[]
  relatedProductsFrom ProductRelatedProduct[] @relation("BaseProduct")
  relatedProductsTo   ProductRelatedProduct[] @relation("RelatedProduct")
  rfqEnquiries        RFQEnquiry[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([templateId])
  @@index([slug])
  @@index([status])
  @@index([isFeatured])
}

// Product Specifications (Dynamic Specifications)
model ProductSpecification {
  id        String                @id @default(cuid())
  productId String
  product   DynamicProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)
  fieldId   String?
  field     ProductTemplateField? @relation(fields: [fieldId], references: [id], onDelete: SetNull)

  specName     String
  specValue    String @db.Text
  displayOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([fieldId])
  @@index([displayOrder])
}

// Product Images
model ProductImage {
  id        String         @id @default(cuid())
  productId String
  product   DynamicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  imageUrl       String
  imageTitle     String?
  altText        String?
  seoDescription String? @db.Text
  imageType      String  @default("gallery") // main, gallery, packaging, certificate, factory
  displayOrder   Int     @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([imageType])
}

// Product Packaging
model ProductPackaging {
  id        String         @id @default(cuid())
  productId String
  product   DynamicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  packageType       String // Mesh Bag, Jute Bag, Carton Box, Wooden Box, etc.
  weight            Int // in kg
  unit              String  @default("kg")
  quantityAvailable Int
  isActive          Boolean @default(true)
  displayOrder      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
}

// Product Certifications
model ProductCertification {
  id        String         @id @default(cuid())
  productId String
  product   DynamicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  certName   String // ISO, HACCP, GlobalGAP, Organic, FDA, CE, RoHS
  certNumber String?
  certImage  String? // URL to certificate image
  issueDate  DateTime?
  expiryDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([certName])
}

// Product SEO
model ProductSEO {
  id        String         @id @default(cuid())
  productId String         @unique
  product   DynamicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  metaTitle       String
  metaDescription String  @db.Text
  metaKeywords    String? @db.Text
  schemaMarkup    Json?
  ogImage         String?
  ogDescription   String?

  updatedAt DateTime @updatedAt

  @@index([productId])
}

// Product Export Information
model ProductExportInfo {
  id        String         @id @default(cuid())
  productId String         @unique
  product   DynamicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  exportCountries    Json // JSON array of country codes
  availabilityStatus String  @default("year_round") // year_round, seasonal, limited
  season             String? // e.g., "Jan-Mar" for seasonal
  moq                Int? // Minimum Order Quantity
  leadTimeDays       Int?
  incoterms          String  @default("FOB") // FOB, CIF, CFR, EXW, DAP

  updatedAt DateTime @updatedAt

  @@index([productId])
}

// Product Documents
model ProductDocument {
  id        String         @id @default(cuid())
  productId String
  product   DynamicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  title        String
  documentUrl  String
  documentType String? // spec sheet, test report, brochure, certificate
  description  String? @db.Text
  displayOrder Int     @default(0)
  isPublic     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([documentType])
}

// Product Videos
model ProductVideo {
  id        String         @id @default(cuid())
  productId String
  product   DynamicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  title        String
  videoUrl     String
  thumbnailUrl String?
  platform     String? // youtube, vimeo, local
  description  String? @db.Text
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([platform])
}

// Product Variants
model ProductVariant {
  id        String         @id @default(cuid())
  productId String
  product   DynamicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantName  String
  sku          String?  @unique
  attributes   Json?
  price        Decimal? @db.Decimal(12, 2)
  moq          Int?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isActive])
}

// Related Products
model ProductRelatedProduct {
  id               String         @id @default(cuid())
  productId        String
  product          DynamicProduct @relation("BaseProduct", fields: [productId], references: [id], onDelete: Cascade)
  relatedProductId String
  relatedProduct   DynamicProduct @relation("RelatedProduct", fields: [relatedProductId], references: [id], onDelete: Cascade)
  relationType     String         @default("related")
  displayOrder     Int            @default(0)

  createdAt DateTime @default(now())

  @@unique([productId, relatedProductId, relationType])
  @@index([productId])
  @@index([relatedProductId])
}

// RFQ Enquiries (Product-specific)
model RFQEnquiry {
  id        String          @id @default(cuid())
  reference String          @unique @default(cuid()) // RFQ-XXXXXXXX format
  productId String?
  product   DynamicProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Contact Information
  buyerName   String
  companyName String?
  email       String
  phone       String
  country     String

  // Product & Requirement Details
  productInterest  String? // Product name from form
  requiredQuantity Int?
  quantity         String?
  unit             String  @default("kg")
  packaging        String?

  // Logistics Information
  incoterms         String? @default("CIF")
  targetPort        String?
  targetPrice       String?
  preferredCurrency String? @default("USD")
  shipmentDate      String?

  // Additional Information
  customSpecifications String? @db.Text
  message              String? @db.Text
  documentUrl          String?
  attachments          String? @db.Text // JSON array
  sourcePage           String? // URL where RFQ was submitted

  // Metadata
  status     String  @default("new") // new, viewed, quoted, converted, rejected
  priority   String  @default("normal") // normal, high, urgent
  assignedTo String? // User ID
  notes      String? @db.Text // Internal admin notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([email])
  @@index([country])
}

model TaskAssignment {
  id     String @id @default(cuid())
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

// ============================================
// INVENTORY MANAGEMENT
// ============================================

model Inventory {
  id          String  @id @default(cuid())
  productId   String
  warehouseId String?

  quantity  Int @default(0)
  reserved  Int @default(0)
  available Int @default(0)

  lastStocked DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// AUDIT & LOGGING
// ============================================

model AuditLog {
  id        String  @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  changes   Json?
  ipAddress String?
  userAgent String? @db.Text

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  title   String
  message String @db.Text

  read   Boolean   @default(false)
  readAt DateTime?

  link String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
}
