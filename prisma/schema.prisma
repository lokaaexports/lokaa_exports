generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  slug        String           @unique
  description String?          @db.Text
  level       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]

  @@index([slug])
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  slug        String           @unique
  description String?          @db.Text
  module      String
  action      String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@index([module])
  @@index([action])
}

model RolePermission {
  roleId       Int
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  username            String?              @unique
  password            String
  emailVerified       Boolean              @default(true)
  firstName           String
  lastName            String
  phone               String?
  avatar              String?
  roleId              Int
  employeeId          String?              @unique
  department          String?
  designation         String?
  reportingManagerId  String?
  joiningDate         DateTime?
  status              String               @default("active")
  isTemporaryPassword Boolean              @default(true)
  lastPasswordChange  DateTime?
  lastLogin           DateTime?
  lastLoginIp         String?
  lastLoginDevice     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  createdActivities   Activity[]           @relation("CreatedBy")
  authTokens          AuthToken[]
  assignedCountries   CountryAssignment[]
  assignedCustomers   CustomerAssignment[]
  assignedLeads       LeadAssignment[]
  loginHistory        LoginHistory[]
  notifications       Notification[]
  createdOrders       Order[]              @relation("CreatedBy")
  createdRFQs         RFQ[]                @relation("CreatedBy")
  updatedRFQs         RFQ[]                @relation("UpdatedBy")
  assignedRFQs        RFQAssignment[]
  completedTasks      Task[]               @relation("CompletedBy")
  createdTasks        Task[]               @relation("CreatedBy")
  assignedTasks       TaskAssignment[]
  role                Role                 @relation(fields: [roleId], references: [id])

  @@index([email])
  @@index([roleId])
  @@index([status])
}

model AuthToken {
  id         String    @id @default(cuid())
  userId     String?
  customerId String?
  email      String
  tokenHash  String
  type       String
  expiresAt  DateTime
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  usedAt     DateTime?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, type])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([customerId])
  @@index([userId])
}

model AuthThrottle {
  id         String   @id @default(cuid())
  scope      String
  identifier String
  count      Int      @default(0)
  resetAt    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([scope, identifier])
  @@index([scope, resetAt])
}

model LoginHistory {
  id        Int      @id @default(autoincrement())
  userId    String
  ip        String?
  device    String?
  userAgent String?  @db.Text
  status    String
  reason    String?
  loginAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loginAt])
}

model Company {
  id                Int      @id @default(autoincrement())
  name              String
  slug              String   @unique
  logo              String?
  favicon           String?
  description       String?  @db.Text
  industry          String?
  website           String?
  email             String?
  phone             String?
  address           String?  @db.Text
  city              String?
  state             String?
  postalCode        String?
  country           String?
  timezone          String   @default("UTC")
  currency          String   @default("USD")
  language          String   @default("en")
  dateFormat        String   @default("YYYY-MM-DD")
  enableTwoFactor   Boolean  @default(false)
  enableAuditLog    Boolean  @default(true)
  enableActivityLog Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([slug])
  @@index([email])
}

model Customer {
  id                 String               @id @default(cuid())
  customerNumber     String?              @unique
  companyName        String
  slug               String               @unique
  registrationNumber String?
  industry           String?
  businessType       String?
  website            String?
  email              String               @unique
  phone              String?
  alternatePhone     String?
  contactName        String?
  contactDesignation String?
  contactEmail       String?
  contactPhone       String?
  country            String?
  address            String?
  gstNumber          String?
  profilePicture     String?
  lastLogin          DateTime?
  passwordHash       String?
  emailVerified      Boolean              @default(false)
  otpCodeHash        String?
  otpExpiresAt       DateTime?
  otpAttempts        Int                  @default(0)
  loginAttempts      Int                  @default(0)
  lastLoginAttempt   DateTime?
  lastPasswordChange DateTime?
  status             String               @default("active")
  rating             Int?
  totalSpent         Decimal              @default(0.000000000000000000000000000000)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  authTokens         AuthToken[]
  addresses          CustomerAddress[]
  assignments        CustomerAssignment[]
  leads              Lead[]
  notes              Note[]
  orders             Order[]
  rfqs               RFQ[]

  @@index([email])
  @@index([status])
  @@index([businessType])
  @@index([slug])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  type       String
  address    String
  city       String
  state      String
  postalCode String
  country    String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerAssignment {
  id         String   @id @default(cuid())
  customerId String
  userId     String
  assignedAt DateTime @default(now())
  assignedBy String?
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([customerId, userId])
  @@index([customerId])
  @@index([userId])
}

model Lead {
  id                 String          @id @default(cuid())
  reference          String          @unique
  customerId         String
  title              String
  description        String?         @db.Text
  source             String?
  status             String          @default("new")
  stage              String?
  interestedProducts String?         @db.Text
  expectedValue      Decimal?
  closingDate        DateTime?
  winProbability     Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  activities         Activity[]
  customer           Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignment         LeadAssignment?
  notes              Note[]

  @@index([customerId])
  @@index([status])
  @@index([reference])
}

model LeadAssignment {
  id         String   @id @default(cuid())
  leadId     String   @unique
  userId     String
  assignedAt DateTime @default(now())
  assignedBy String?
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([userId])
}

model Activity {
  id            String   @id @default(cuid())
  leadId        String?
  type          String
  title         String
  description   String?  @db.Text
  oldValue      String?  @db.Text
  newValue      String?  @db.Text
  createdBy     String?
  createdAt     DateTime @default(now())
  createdByUser User?    @relation("CreatedBy", fields: [createdBy], references: [id])
  lead          Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([type])
  @@index([createdAt])
  @@index([createdBy])
}

model Note {
  id         String    @id @default(cuid())
  content    String    @db.Text
  customerId String?
  leadId     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([leadId])
}

model Country {
  id          String              @id @default(cuid())
  code        String              @unique
  name        String              @unique
  region      String?
  createdAt   DateTime            @default(now())
  assignments CountryAssignment[]

  @@index([code])
  @@index([region])
}

model CountryAssignment {
  id         String   @id @default(cuid())
  countryId  String
  userId     String
  assignedAt DateTime @default(now())
  country    Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([countryId, userId])
  @@index([countryId])
  @@index([userId])
}

model RFQ {
  id                  String         @id @default(cuid())
  reference           String         @unique
  customerId          String
  submittedDate       DateTime
  productInterest     String?        @db.Text
  quantity            Int?
  unit                String?
  shipmentDate        DateTime?
  assignedSalesPerson String?
  status              String         @default("new")
  priority            String         @default("normal")
  internalNotes       String?        @db.Text
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  expiresAt           DateTime?
  orders              Order[]
  createdByUser       User?          @relation("CreatedBy", fields: [createdBy], references: [id])
  customer            Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  updatedByUser       User?          @relation("UpdatedBy", fields: [updatedBy], references: [id])
  assignment          RFQAssignment?
  items               RFQItem[]
  quotations          RFQQuotation[]

  @@index([customerId])
  @@index([status])
  @@index([reference])
  @@index([createdAt])
  @@index([createdBy])
  @@index([updatedBy])
}

model RFQItem {
  id          String   @id @default(cuid())
  rfqId       String
  productId   String?
  description String?
  quantity    Int
  unit        String
  createdAt   DateTime @default(now())
  rfq         RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
}

model RFQQuotation {
  id         String   @id @default(cuid())
  rfqId      String
  version    Int      @default(1)
  items      String   @db.Text
  subtotal   Decimal
  tax        Decimal  @default(0.000000000000000000000000000000)
  total      Decimal
  currency   String   @default("USD")
  validUntil DateTime
  notes      String?  @db.Text
  status     String   @default("draft")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  rfq        RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@index([status])
}

model RFQAssignment {
  id         String   @id @default(cuid())
  rfqId      String   @unique
  userId     String
  assignedAt DateTime @default(now())
  rfq        RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@index([userId])
}

model Order {
  id                String      @id @default(cuid())
  reference         String      @unique
  customerId        String
  rfqId             String?
  subtotal          Decimal     @default(0.000000000000000000000000000000)
  tax               Decimal     @default(0.000000000000000000000000000000)
  discount          Decimal     @default(0.000000000000000000000000000000)
  shipping          Decimal     @default(0.000000000000000000000000000000)
  total             Decimal     @default(0.000000000000000000000000000000)
  currency          String      @default("USD")
  shipmentAddress   String?     @db.Text
  shippingMethod    String?
  estimatedDelivery DateTime?
  status            String      @default("pending")
  paymentStatus     String      @default("unpaid")
  createdBy         String
  notes             String?     @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  createdByUser     User        @relation("CreatedBy", fields: [createdBy], references: [id])
  customer          Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rfq               RFQ?        @relation(fields: [rfqId], references: [id])
  items             OrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([reference])
  @@index([createdBy])
  @@index([rfqId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal
  total     Decimal
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Task {
  id              String           @id @default(cuid())
  title           String
  description     String?          @db.Text
  type            String?
  dueDate         DateTime
  status          String           @default("pending")
  priority        String           @default("normal")
  createdBy       String
  completedBy     String?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  completedByUser User?            @relation("CompletedBy", fields: [completedBy], references: [id])
  createdByUser   User             @relation("CreatedBy", fields: [createdBy], references: [id])
  assignments     TaskAssignment[]

  @@index([status])
  @@index([completedBy])
  @@index([createdBy])
}

model ProductCategory {
  id            String               @id @default(cuid())
  name          String               @unique
  slug          String               @unique
  description   String?              @db.Text
  image         String?
  displayOrder  Int                  @default(0)
  status        String               @default("active")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  products      DynamicProduct[]
  subcategories ProductSubcategory[]
  templates     ProductTemplate[]

  @@index([slug])
  @@index([status])
}

model ProductSubcategory {
  id           String            @id @default(cuid())
  categoryId   String
  name         String
  slug         String
  description  String?           @db.Text
  displayOrder Int               @default(0)
  status       String            @default("active")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  products     DynamicProduct[]
  category     ProductCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  templates    ProductTemplate[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([slug])
}

model ProductTemplate {
  id            String                 @id @default(cuid())
  categoryId    String
  subcategoryId String?
  name          String
  slug          String
  description   String?                @db.Text
  fieldCount    Int                    @default(0)
  isActive      Boolean                @default(true)
  displayOrder  Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  products      DynamicProduct[]
  category      ProductCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory   ProductSubcategory?    @relation(fields: [subcategoryId], references: [id])
  fields        ProductTemplateField[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isActive])
  @@index([subcategoryId])
}

model ProductTemplateField {
  id              String                 @id @default(cuid())
  templateId      String
  fieldName       String
  fieldLabel      String
  fieldType       String
  isRequired      Boolean                @default(false)
  displayOrder    Int
  placeholder     String?
  helpText        String?                @db.Text
  validationRules String?                @db.Text
  defaultValue    String?
  options         String?                @db.Text
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  specifications  ProductSpecification[]
  template        ProductTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([displayOrder])
}

model DynamicProduct {
  id                  String                  @id @default(cuid())
  productName         String
  slug                String                  @unique
  categoryId          String
  subcategoryId       String?
  templateId          String
  shortDescription    String?                 @db.Text
  description         String?                 @db.Text
  exportDescription   String?                 @db.Text
  hsnCode             String?
  productType         String?
  status              String                  @default("draft")
  approvalStatus      String                  @default("pending")
  isFeatured          Boolean                 @default(false)
  availabilityStatus  String                  @default("in_stock")
  mainImage           String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  publishedAt         DateTime?
  category            ProductCategory         @relation(fields: [categoryId], references: [id])
  subcategory         ProductSubcategory?     @relation(fields: [subcategoryId], references: [id])
  template            ProductTemplate         @relation(fields: [templateId], references: [id])
  activityLogs        ProductActivityLog[]
  certifications      ProductCertification[]
  documents           ProductDocument[]
  exportInfo          ProductExportInfo?
  images              ProductImage[]
  packaging           ProductPackaging[]
  relatedProductsFrom ProductRelatedProduct[] @relation("BaseProduct")
  relatedProductsTo   ProductRelatedProduct[] @relation("RelatedProduct")
  seo                 ProductSEO?
  specifications      ProductSpecification[]
  variants            ProductVariant[]
  versions            ProductVersion[]
  videos              ProductVideo[]
  rfqEnquiries        RFQEnquiry[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([templateId])
  @@index([slug])
  @@index([status])
  @@index([isFeatured])
}

model ProductVersion {
  id            String         @id @default(cuid())
  productId     String
  versionNumber Int
  changes       String         @db.Text
  createdBy     String?
  createdAt     DateTime       @default(now())
  product       DynamicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductActivityLog {
  id          String         @id @default(cuid())
  productId   String
  action      String
  description String?
  userId      String?
  createdAt   DateTime       @default(now())
  product     DynamicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSpecification {
  id           String                @id @default(cuid())
  productId    String
  fieldId      String?
  specName     String
  specValue    String                @db.Text
  displayOrder Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  field        ProductTemplateField? @relation(fields: [fieldId], references: [id])
  product      DynamicProduct        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([fieldId])
  @@index([displayOrder])
}

model ProductImage {
  id             String         @id @default(cuid())
  productId      String
  imageUrl       String
  imageTitle     String?
  altText        String?
  seoDescription String?        @db.Text
  imageType      String         @default("gallery")
  displayOrder   Int            @default(0)
  createdAt      DateTime       @default(now())
  product        DynamicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([imageType])
}

model ProductPackaging {
  id                String         @id @default(cuid())
  productId         String
  packageType       String
  weight            Int
  unit              String         @default("kg")
  quantityAvailable Int
  isActive          Boolean        @default(true)
  displayOrder      Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  product           DynamicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isActive])
}

model ProductCertification {
  id         String         @id @default(cuid())
  productId  String
  certName   String
  certNumber String?
  certImage  String?
  issueDate  DateTime?
  expiryDate DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  product    DynamicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([certName])
}

model ProductSEO {
  id              String         @id @default(cuid())
  productId       String         @unique
  metaTitle       String
  metaDescription String         @db.Text
  metaKeywords    String?        @db.Text
  schemaMarkup    String?        @db.Text
  ogImage         String?
  ogDescription   String?
  updatedAt       DateTime       @updatedAt
  product         DynamicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductExportInfo {
  id                 String         @id @default(cuid())
  productId          String         @unique
  exportCountries    String         @db.Text
  availabilityStatus String         @default("year_round")
  season             String?
  moq                Int?
  leadTimeDays       Int?
  incoterms          String         @default("FOB")
  updatedAt          DateTime       @updatedAt
  product            DynamicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductDocument {
  id           String         @id @default(cuid())
  productId    String
  title        String
  documentUrl  String
  documentType String?
  description  String?        @db.Text
  displayOrder Int            @default(0)
  isPublic     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  product      DynamicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([documentType])
}

model ProductVideo {
  id           String         @id @default(cuid())
  productId    String
  title        String
  videoUrl     String
  thumbnailUrl String?
  platform     String?
  description  String?        @db.Text
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  product      DynamicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([platform])
}

model ProductVariant {
  id           String         @id @default(cuid())
  productId    String
  variantName  String
  sku          String?        @unique
  attributes   String?        @db.Text
  price        Decimal?       @db.Decimal(12, 2)
  moq          Int?
  isActive     Boolean        @default(true)
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  product      DynamicProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isActive])
}

model ProductRelatedProduct {
  id               String         @id @default(cuid())
  productId        String
  relatedProductId String
  relationType     String         @default("related")
  displayOrder     Int            @default(0)
  createdAt        DateTime       @default(now())
  product          DynamicProduct @relation("BaseProduct", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct   DynamicProduct @relation("RelatedProduct", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId, relationType])
  @@index([productId])
  @@index([relatedProductId])
}

model RFQEnquiry {
  id                   String          @id @default(cuid())
  reference            String          @unique @default(cuid())
  productId            String?
  buyerName            String
  companyName          String?
  email                String
  phone                String
  country              String
  productInterest      String?
  requiredQuantity     Int?
  quantity             String?
  unit                 String          @default("kg")
  packaging            String?
  incoterms            String?         @default("CIF")
  targetPort           String?
  targetPrice          String?
  preferredCurrency    String?         @default("USD")
  shipmentDate         String?
  customSpecifications String?         @db.Text
  message              String?         @db.Text
  documentUrl          String?
  attachments          String?         @db.Text
  sourcePage           String?
  status               String          @default("new")
  priority             String          @default("normal")
  assignedTo           String?
  notes                String?         @db.Text
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  product              DynamicProduct? @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([email])
  @@index([country])
}

model TaskAssignment {
  id         String   @id @default(cuid())
  taskId     String
  userId     String
  assignedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model Inventory {
  id          String    @id @default(cuid())
  productId   String
  warehouseId String?
  quantity    Int       @default(0)
  reserved    Int       @default(0)
  available   Int       @default(0)
  lastStocked DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([productId])
  @@index([warehouseId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  changes   String?  @db.Text
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String    @db.Text
  read      Boolean   @default(false)
  readAt    DateTime?
  link      String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model EmailQueue {
  id          String    @id @default(cuid())
  to          String
  subject     String
  htmlContent String    @db.Text
  status      String    @default("pending")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?   @db.Text
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

model rfqs {
  id                   String   @id @default(cuid())
  reference            String   @unique
  fullName             String?
  contactPerson        String?
  email                String?
  phone                String?
  company              String?
  country              String?
  productInterest      String?  @db.Text
  quantity             String?
  packaging            String?
  incoterms            String?
  shippingTerms        String?
  targetPort           String?
  destinationPort      String?
  targetPrice          String?
  preferredCurrency    String?
  shipmentDate         String?
  message              String?  @db.Text
  notes                String?  @db.Text
  customSpecifications String?  @db.Text
  attachments          String?  @db.Text
  sourcePage           String?  @db.Text
  ipAddress            String?
  status               String?  @default("new")
  priority             String?  @default("normal")
  customer_id          String?
  assignedSalesPerson  String?
  followUpDate         String?
  history              String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model MediaAsset {
  id          Int      @id @default(autoincrement())
  assetType   String?  @db.VarChar(255)
  entityType  String?  @db.VarChar(255)
  filename    String   @db.VarChar(255)
  mimeType    String   @db.VarChar(255)
  sizeBytes   Int
  url         String   @db.VarChar(255)
  fileData    Bytes?
  contentType String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("media_assets")
}
