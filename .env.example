# Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=your_db_name
DATABASE_URL="mysql://your_db_user:your_db_password@127.0.0.1:3306/your_db_name"

# Application Settings
NEXT_PUBLIC_BASE_URL=https://yourdomain.com
UPLOAD_STORAGE_MODE=filesystem
UPLOAD_PUBLIC_BASE_URL=https://yourdomain.com

# Authentication & JWT Secrets
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars

# Mail & SMTP
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=auth@yourdomain.com
SMTP_PASS=your_email_password
EMAIL_FROM=auth@yourdomain.com
