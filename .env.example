MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=your-mysql-database
MYSQL_SSL=true
DATABASE_URL="mysql://your-mysql-user:your-mysql-password@your-mysql-host:3306/your-mysql-database?sslaccept=strict"
NEXT_PUBLIC_BASE_URL=https://your-production-domain.example
CORS_ORIGINS=https://your-production-domain.example
JWT_SECRET=replace-with-a-long-random-secret
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email-user
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=your-email@example.com
UPLOAD_STORAGE_MODE=db
UPLOAD_STORAGE_DIR=
UPLOAD_PUBLIC_BASE_URL=https://your-production-domain.example
